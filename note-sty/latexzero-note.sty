\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{latexzero-note}[2026/08/21 v0.2.0 LaTeXzero note styles]

\def\latexzeronote@style{default}
\DeclareOption{style=default}{\def\latexzeronote@style{default}}
\DeclareOption{style=attached}{\def\latexzeronote@style{attached}}
\DeclareOption{style=leftbar}{\def\latexzeronote@style{leftbar}}
\DeclareOption{style=shaded}{\def\latexzeronote@style{shaded}}
\DeclareOption{style=plain}{\def\latexzeronote@style{plain}}
\DeclareOption*{%
    \PackageError{latexzero-note}{Unknown option `\CurrentOption'}%
    {Available styles are default, attached, leftbar, shaded, and plain.}%
}
\ProcessOptions\relax

\def\latexzeronote@style@default{default}
\def\latexzeronote@style@attached{attached}
\def\latexzeronote@style@leftbar{leftbar}
\def\latexzeronote@style@shaded{shaded}
\def\latexzeronote@style@plain{plain}

\RequirePackage{amsmath,amsthm,amssymb}
\RequirePackage{mathtools}
\RequirePackage{mathrsfs}
\RequirePackage{bm}
\RequirePackage{extarrows}
\RequirePackage[a4paper, margin=1in]{geometry}
\RequirePackage{float}
\RequirePackage{indentfirst}
\RequirePackage{booktabs,multirow}
\RequirePackage[shortlabels,inline]{enumitem}
\RequirePackage{appendix}

\RequirePackage[dvipsnames]{xcolor}
\RequirePackage{graphicx}
\graphicspath{
    {./figure/}{./figures/}{./image/}{./images/}{./graphic/}{./graphics/}{./picture/}{./pictures/}
}
\RequirePackage{subcaption}

\RequirePackage[ruled,linesnumbered,noline]{algorithm2e}
\RequirePackage{listings}
\lstdefinestyle{simpleStyle}{
    basicstyle=\ttfamily\small,
    breaklines=true,
    keywordstyle=\color{blue},
    identifierstyle=\color{black},
    stringstyle=\color{violet},
    commentstyle=\color[RGB]{34,139,34},
    showstringspaces=false,
    numbers=left,
    numbersep=2em,
    numberstyle=\footnotesize,
    frame=single,
    framesep=1em,
}
\lstset{style=simpleStyle}

\RequirePackage{hyperref}
\hypersetup{
    colorlinks=true,linkcolor=,urlcolor=cyan
}

\renewcommand*{\proofname}{\normalfont\bfseries Proof}

\ifx\latexzeronote@style\latexzeronote@style@plain
    \RequirePackage{keytheorems}
\else
    \RequirePackage[most]{tcolorbox}
    \RequirePackage{keytheorems}
\fi

%% define environments

\ifx\latexzeronote@style\latexzeronote@style@attached
    \tcbset{
        attached theorem box/.style={
                enhanced,
                breakable,
                sharp corners,
                boxrule=1pt,
                coltitle=white,
                fonttitle=\bfseries,
                attach boxed title to top left={xshift=3mm,yshift=-2.5mm},
                boxed title style={
                        sharp corners,
                        boxrule=0pt,
                        left=1mm,
                        right=1mm,
                        top=0.4mm,
                        bottom=0.4mm,
                    },
                top=3mm,
            },
        attached theorem box rounded/.style={
                attached theorem box,
                rounded corners,
                boxed title style={rounded corners},
            }
    }

    \newkeytheoremstyle{attachedplain}{
        inherit-style=plain,
        headpunct={},
        noteseparator={:~},
        notebraces={{}{}}
    }
    \newkeytheoremstyle{attacheddefinition}{
        inherit-style=definition,
        headpunct={},
        noteseparator={:~},
        notebraces={{}{}}
    }

    \newkeytheorem{theorem}[style=attachedplain, name=Theorem, numbered=true, parent=section,
        tcolorbox={attached theorem box, colframe=RoyalPurple, colback=RoyalPurple!8, colbacktitle=RoyalPurple}]
    \newkeytheorem{theorem*}[style=attachedplain, name=Theorem, numbered=false,
        tcolorbox={attached theorem box rounded, colframe=RoyalPurple, colback=RoyalPurple!8, colbacktitle=RoyalPurple}]

    \newkeytheorem{proposition}[style=attachedplain, name=Proposition, numbered=true, sibling=theorem,
        tcolorbox={attached theorem box, colframe=RoyalPurple, colback=RoyalPurple!8, colbacktitle=RoyalPurple}]
    \newkeytheorem{proposition*}[style=attachedplain, name=Proposition, numbered=false,
        tcolorbox={attached theorem box rounded, colframe=RoyalPurple, colback=RoyalPurple!8, colbacktitle=RoyalPurple}]

    \newkeytheorem{corollary}[style=attachedplain, name=Corollary, numbered=true, sibling=theorem,
        tcolorbox={attached theorem box, colframe=NavyBlue, colback=SkyBlue!8, colbacktitle=NavyBlue}]
    \newkeytheorem{corollary*}[style=attachedplain, name=Corollary, numbered=false,
        tcolorbox={attached theorem box rounded, colframe=NavyBlue, colback=SkyBlue!8, colbacktitle=NavyBlue}]

    \newkeytheorem{lemma}[style=attachedplain, name=Lemma, numbered=true, sibling=theorem,
        tcolorbox={attached theorem box, colframe=NavyBlue, colback=SkyBlue!8, colbacktitle=NavyBlue}]
    \newkeytheorem{lemma*}[style=attachedplain, name=Lemma, numbered=false,
        tcolorbox={attached theorem box rounded, colframe=NavyBlue, colback=SkyBlue!8, colbacktitle=NavyBlue}]

    \newkeytheorem{claim}[style=attachedplain, name=Claim, numbered=true, sibling=theorem,
        tcolorbox={attached theorem box, colframe=NavyBlue, colback=SkyBlue!8, colbacktitle=NavyBlue}]
    \newkeytheorem{claim*}[style=attachedplain, name=Claim, numbered=false,
        tcolorbox={attached theorem box rounded, colframe=NavyBlue, colback=SkyBlue!8, colbacktitle=NavyBlue}]

    \newkeytheorem{definition}[style=attacheddefinition, name=Definition, numbered=true, parent=section,
        tcolorbox={attached theorem box, colframe=ForestGreen, colback=ForestGreen!5, colbacktitle=ForestGreen}]
    \newkeytheorem{definition*}[style=attacheddefinition, name=Definition, numbered=false,
        tcolorbox={attached theorem box rounded, colframe=ForestGreen, colback=ForestGreen!5, colbacktitle=ForestGreen}]

    \newkeytheorem{example}[style=attacheddefinition, name=Example, numbered=true, parent=section,
        tcolorbox={attached theorem box, colframe=RawSienna, colback=RawSienna!5, colbacktitle=RawSienna}]
    \newkeytheorem{example*}[style=attacheddefinition, name=Example, numbered=false,
        tcolorbox={attached theorem box rounded, colframe=RawSienna, colback=RawSienna!5, colbacktitle=RawSienna}]

    \newkeytheorem{problem}[style=attacheddefinition, name=Problem, numbered=true, parent=section,
        tcolorbox={attached theorem box, colframe=WildStrawberry!30, colback=WildStrawberry!5, colbacktitle=WildStrawberry}]
    \newkeytheorem{problem*}[style=attacheddefinition, name=Problem, numbered=false,
        tcolorbox={attached theorem box rounded, colframe=WildStrawberry!30, colback=WildStrawberry!5, colbacktitle=WildStrawberry}]
\else
    \ifx\latexzeronote@style\latexzeronote@style@plain
        \newkeytheorem{theorem}[style=plain, name=Theorem, numbered=true, parent=section]
        \newkeytheorem{theorem*}[style=plain, name=Theorem, numbered=false]

        \newkeytheorem{proposition}[style=plain, name=Proposition, numbered=true, sibling=theorem]
        \newkeytheorem{proposition*}[style=plain, name=Proposition, numbered=false]

        \newkeytheorem{corollary}[style=plain, name=Corollary, numbered=true, sibling=theorem]
        \newkeytheorem{corollary*}[style=plain, name=Corollary, numbered=false]

        \newkeytheorem{lemma}[style=plain, name=Lemma, numbered=true, sibling=theorem]
        \newkeytheorem{lemma*}[style=plain, name=Lemma, numbered=false]

        \newkeytheorem{claim}[style=plain, name=Claim, numbered=true, sibling=theorem]
        \newkeytheorem{claim*}[style=plain, name=Claim, numbered=false]

        \newkeytheorem{definition}[style=definition, name=Definition, numbered=true, parent=section]
        \newkeytheorem{definition*}[style=definition, name=Definition, numbered=false]

        \newkeytheorem{example}[style=definition, name=Example, numbered=true, parent=section]
        \newkeytheorem{example*}[style=definition, name=Example, numbered=false]

        \newkeytheorem{problem}[style=definition, name=Problem, numbered=true, parent=section]
        \newkeytheorem{problem*}[style=definition, name=Problem, numbered=false]
    \else
        \ifx\latexzeronote@style\latexzeronote@style@default
            \tcbset{
                theorem box/.style={enhanced, breakable, sharp corners, boxrule=1pt},
                theorem box rounded/.style={theorem box, rounded corners},
                theorem purple/.style={colframe=RoyalPurple, colback=RoyalPurple!8},
                theorem blue/.style={colframe=NavyBlue, colback=SkyBlue!8},
                theorem green/.style={colframe=ForestGreen, colback=ForestGreen!5},
                theorem brown/.style={colframe=RawSienna, colback=RawSienna!5},
                theorem red/.style={colframe=WildStrawberry!30, colback=WildStrawberry!5},
            }
        \else\ifx\latexzeronote@style\latexzeronote@style@leftbar
                \tcbset{
                    theorem box/.style={
                            enhanced, breakable, sharp corners,
                            leftrule=2pt, rightrule=0pt, toprule=0pt, bottomrule=0pt,
                        },
                    theorem box rounded/.style={theorem box, rounded corners},
                    theorem purple/.style={colframe=RoyalPurple, colback=RoyalPurple!8},
                    theorem blue/.style={colframe=NavyBlue, colback=SkyBlue!8},
                    theorem green/.style={colframe=ForestGreen, colback=ForestGreen!5},
                    theorem brown/.style={colframe=RawSienna, colback=RawSienna!5},
                    theorem red/.style={colframe=WildStrawberry!30, colback=WildStrawberry!5},
                }
            \else\ifx\latexzeronote@style\latexzeronote@style@shaded
                    \tcbset{
                        theorem box/.style={
                                enhanced, breakable, sharp corners,
                                boxrule=0pt, colframe=white,
                            },
                        theorem box rounded/.style={theorem box, rounded corners},
                        theorem purple/.style={colback=RoyalPurple!8},
                        theorem blue/.style={colback=SkyBlue!8},
                        theorem green/.style={colback=ForestGreen!5},
                        theorem brown/.style={colback=RawSienna!5},
                        theorem red/.style={colback=WildStrawberry!5},
                    }
                \fi
            \fi
        \fi

        \newkeytheorem{theorem}[style=plain, name=Theorem, numbered=true, parent=section,
            tcolorbox-no-titlebar={theorem box, theorem purple}]
        \newkeytheorem{theorem*}[style=plain, name=Theorem, numbered=false,
            tcolorbox-no-titlebar={theorem box rounded, theorem purple}]

        \newkeytheorem{proposition}[style=plain, name=Proposition, numbered=true, sibling=theorem,
            tcolorbox-no-titlebar={theorem box, theorem purple}]
        \newkeytheorem{proposition*}[style=plain, name=Proposition, numbered=false,
            tcolorbox-no-titlebar={theorem box rounded, theorem purple}]

        \newkeytheorem{corollary}[style=plain, name=Corollary, numbered=true, sibling=theorem,
            tcolorbox-no-titlebar={theorem box, theorem blue}]
        \newkeytheorem{corollary*}[style=plain, name=Corollary, numbered=false,
            tcolorbox-no-titlebar={theorem box rounded, theorem blue}]

        \newkeytheorem{lemma}[style=plain, name=Lemma, numbered=true, sibling=theorem,
            tcolorbox-no-titlebar={theorem box, theorem blue}]
        \newkeytheorem{lemma*}[style=plain, name=Lemma, numbered=false,
            tcolorbox-no-titlebar={theorem box rounded, theorem blue}]

        \newkeytheorem{claim}[style=plain, name=Claim, numbered=true, sibling=theorem,
            tcolorbox-no-titlebar={theorem box, theorem blue}]
        \newkeytheorem{claim*}[style=plain, name=Claim, numbered=false,
            tcolorbox-no-titlebar={theorem box rounded, theorem blue}]

        \newkeytheorem{definition}[style=definition, name=Definition, numbered=true, parent=section,
            tcolorbox-no-titlebar={theorem box, theorem green}]
        \newkeytheorem{definition*}[style=definition, name=Definition, numbered=false,
            tcolorbox-no-titlebar={theorem box rounded, theorem green}]

        \newkeytheorem{example}[style=definition, name=Example, numbered=true, parent=section,
            tcolorbox-no-titlebar={theorem box, theorem brown}]
        \newkeytheorem{example*}[style=definition, name=Example, numbered=false,
            tcolorbox-no-titlebar={theorem box rounded, theorem brown}]

        \newkeytheorem{problem}[style=definition, name=Problem, numbered=true, parent=section,
            tcolorbox-no-titlebar={theorem box, theorem red}]
        \newkeytheorem{problem*}[style=definition, name=Problem, numbered=false,
            tcolorbox-no-titlebar={theorem box rounded, theorem red}]
    \fi
\fi

\newkeytheorem{remark}[style=remark, name=Remark, numbered=true, parent=section]
\newkeytheorem{remark*}[style=remark, name=Remark, numbered=false]

\newkeytheoremstyle{notestyle}{headfont=\color{orange!80}\bfseries, bodyfont=\normalfont, spaceabove=3pt, spacebelow=3pt}

\newkeytheorem{note}[style=notestyle, name=Note, numbered=true, parent=section]
\newkeytheorem{note*}[style=notestyle, name=Note, numbered=false]

\newkeytheoremstyle{solutionstyle}{headfont=\bfseries, bodyfont=\normalfont, spaceabove=3pt, spacebelow=3pt, qed=\ensuremath{\square}}

\newkeytheorem{solution}[style=solutionstyle, name=Solution, numbered=true, parent=section]
\newkeytheorem{solution*}[style=solutionstyle, name=Solution, numbered=false]

\ifx\latexzeronote@style\latexzeronote@style@plain
    \newenvironment{cbox}{\begin{quote}}{\end{quote}}
\else
    %% cbox
    \newtcolorbox{cbox}[1][]{%
        enhanced,
        breakable,
        sharp corners,
        leftrule=2pt, rightrule=0pt, toprule=0pt, bottomrule=0pt,
        colframe=SkyBlue,
        colback=SkyBlue!8,
        #1
    }
\fi

%% cover
\RequirePackage{titling}
\newcommand{\extrainfo}{}
\renewcommand{\extrainfo}[1]{\renewcommand{\extrainfocontent}{#1}}
\newcommand{\extrainfocontent}{}
\newcommand{\makecover}[1]{%
    \begin{titlepage}
        \newgeometry{margin=0in}
        \parindent=0pt
        \includegraphics[width=\linewidth]{#1} % size = 1280*1024
        \vfill
        \begin{center}
            \parbox{0.618\textwidth}{%
                \raggedleft{\bfseries \Huge \thetitle} \\[0.6pt]
                \rule{0.618\textwidth}{4pt} \\
            }
        \end{center}
        \vfill
        \begin{center}
            \parbox{0.618\textwidth}{%
                \raggedleft\Large
                \begin{tabular}{r}
                    \theauthor \\
                    \thedate   \\
                \end{tabular}%
            }
        \end{center}
        \vfill
        \begin{center}
            \parbox[t]{0.7\textwidth}{\centering \itshape \extrainfocontent}
        \end{center}
        \vfill
    \end{titlepage}
    \restoregeometry
    \thispagestyle{empty}
}
% USAGE
% \extrainfo{xxx}
% \makecover{/path/to/cover.png}

\endinput
